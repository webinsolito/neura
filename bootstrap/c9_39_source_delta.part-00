diff --git a/capo_local/src/integrated_security_model_fabric_test.go b/capo_local/src/integrated_security_model_fabric_test.go
new file mode 100644
index 0000000..2aa49a2
--- /dev/null
+++ b/capo_local/src/integrated_security_model_fabric_test.go
@@ -0,0 +1,150 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	wardenapi "neura/capo-local/warden"
+)
+
+func writeIntegratedWardenPolicy(t *testing.T, root string, allowedHosts []string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Join(root, "capo_local", "src"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	p := wardenapi.Policy{
+		Version:            1,
+		FailClosed:         true,
+		AllowedTools:       []string{"local_ai"},
+		AllowedRoots:       []string{"capo_local/src"},
+		AllowedHosts:       allowedHosts,
+		AllowedProcesses:   []string{"go", "go.exe"},
+		MaxLeaseTTLSeconds: 30,
+		MaxActionsPerLease: 1,
+		MaxCostPerLease:    10,
+		RecurringCostEUR:   0,
+	}
+	b, _ := json.MarshalIndent(p, "", "  ")
+	b = append(b, '\n')
+	if err := os.WriteFile(filepath.Join(root, "capo_local", "warden_policy.json"), b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(b)
+	lock := wardenapi.PolicyLock{Version: 1, Algorithm: "sha256", SHA256: hex.EncodeToString(sum[:]), Policy: "fail_closed", RecurringCostEUR: 0}
+	lb, _ := json.MarshalIndent(lock, "", "  ")
+	lb = append(lb, '\n')
+	if err := os.WriteFile(filepath.Join(root, "capo_local", "warden_policy.lock.json"), lb, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func newIntegratedTestServer(t *testing.T, root string, aiURL string) *Server {
+	t.Helper()
+	writeTestCapabilities(t, root)
+	cfg := defaultConfig()
+	// Deliberately use localhost here. The alternate provider below is bound to
+	// 127.0.0.1 and the Warden policy only permits 127.0.0.1. A stale
+	// authorization against cfg.LlamaURL would therefore fail this test.
+	cfg.LlamaURL = "http://localhost:1"
+	cfg.LlamaModel = "primary-down"
+	cfg.ExternalWardenRequired = true
+	t.Setenv("NEURA_BONSAI_URL", aiURL)
+	t.Setenv("NEURA_BONSAI_MODEL", "Bonsai-2-27B")
+	t.Setenv("NEURA_GPTOSS_URL", "")
+	t.Setenv("NEURA_QWEN_URL", "")
+	t.Setenv("NEURA_BITNET_URL", "")
+	s := &Server{cfg: cfg, rootDir: root, client: &http.Client{Timeout: 2 * time.Second}, providerKeys: map[string]string{}, providerHealth: map[string]*providerHealthState{}}
+	s.initGovernance()
+	if s.warden == nil {
+		t.Fatalf("external warden not started: %s", s.wardenErr)
+	}
+	t.Cleanup(func() { _ = s.warden.Close() })
+	return s
+}
+
+func TestC939AlternateProviderAuthorizedAtFrozenSelectedEndpoint(t *testing.T) {
+	if os.Getenv("NEURA_WARDEN_BIN") == "" {
+		t.Skip("NEURA_WARDEN_BIN not set for integrated Warden test")
+	}
+	v