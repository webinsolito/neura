.initGovernance()
+	srv.replay = nil
+	mgr := &EvolutionManager{srv: srv, cfg: defaultEvolutionConfig(), stopCh: make(chan struct{})}
+	out, err := mgr.callLocalJSON(context.Background(), "architect", "{}", 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out, `"provider":"bonsai"`) {
+		t.Fatalf("unexpected output %q", out)
+	}
+	if completions != 1 {
+		t.Fatalf("expected exactly one Bonsai completion, got %d", completions)
+	}
+}
