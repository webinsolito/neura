diff --git a/capo_local/src/replay.go b/capo_local/src/replay.go
index c6af989..5dbd8d1 100644
--- a/capo_local/src/replay.go
+++ b/capo_local/src/replay.go
@@ -319,6 +319,25 @@ func (r *ReplayStore) poisonUnlocked(cause error) {
 	r.err = "replay_store_poisoned: " + cause.Error()
 }
 
+func (r *ReplayStore) PreflightString(operation, component, model string, input any) (ReplayMode, bool, error) {
+	if r == nil {
+		return ReplayOff, false, nil
+	}
+	r.mu.Lock()
+	mode := r.mode
+	valid := r.valid
+	why := r.err
+	r.mu.Unlock()
+	if !valid {
+		return mode, false, errors.New(why)
+	}
+	if mode != ReplayUse && mode != ReplayStrict {
+		return mode, false, nil
+	}
+	_, ok, err := r.lookup(operation, component, model, input)
+	return mode, ok, err
+}
+
