+func testOpenAIModelServer(t *testing.T, modelIDs []string, content string) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/health":
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{"ok":true}`))
+		case "/v1/models":
+			data := make([]map[string]string, 0, len(modelIDs))
+			for _, id := range modelIDs {
+				data = append(data, map[string]string{"id": id})
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"data": data})
+		case "/v1/chat/completions":
+			_ = json.NewEncoder(w).Encode(map[string]any{"choices": []any{map[string]any{"message": map[string]any{"role": "assistant", "content": content}}}})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+}
+
+func TestModelFabricTaskAwareBonsaiAndBitNetRouting(t *testing.T) {
+	models := testOpenAIModelServer(t, []string{"Bonsai-2-27B", "BitNet-b1.58-2B-4T"}, `{"ok":true}`)
+	defer models.Close()
+	t.Setenv("NEURA_BONSAI_URL", models.URL)
+	t.Setenv("NEURA_BITNET_URL", models.URL)
+	t.Setenv("NEURA_GPTOSS_URL", "")
+	t.Setenv("NEURA_QWEN_URL", "")
+	m := OpenModelFabric(t.TempDir(), "http://127.0.0.1:1", "primary")
+	client := &http.Client{Timeout: 2 * time.Second}
+
+	coding, ok := m.SelectRoute(context.Background(), client, ModelTaskCoding, "http://127.0.0.1:1", "primary")
+	if !ok || coding.Candidate.ID != "bonsai2-27b" {
+		t.Fatalf("coding route=%+v ok=%t", coding, ok)
+	}
+	routing, ok := m.SelectRoute(context.Background(), client, ModelTaskRouting, "http://127.0.0.1:1", "primary")
+	if !ok || routing.Candidate.ID != "bitnet" {
+		t.Fatalf("routing route=%+v ok=%t", routing, ok)
+	}
+}
+
+func TestModelFabricRejectsModelMismatchAndFallsBack(t *testing.T) {
+	wrong := testOpenAIModelServer(t, []string{"not-bonsai"}, `{"bad":true}`)
+	defer wrong.Close()
+	primary := testOpenAIModelServer(t, []string{"primary"}, `{"fallback":true}`)
+	defer primary.Close()
+	t.Setenv("NEURA_BONSAI_URL", wrong.URL)
+	t.Setenv("NEURA_BITNET_URL", "")
+	t.Setenv("NEURA_GPTOSS_URL", "")
+	t.Setenv("NEURA_QWEN_URL", "")
+	m := OpenModelFabric(t.TempDir(), primary.URL, "primary")
+	route, ok := m.SelectRoute(context.Background(), &http.Client{Timeout: 2 * time.Second}, ModelTaskCoding, primary.URL, "primary")
+	if !ok || route.Candidate.ID != "llama.cpp" {
+		t.Fatalf("mismatched provider must not win; route=%+v ok=%t", route, ok)
+	}
+}
+
+func TestModelFabricGenericJSONAdapterUsesSelectedLocalModel(t *testing.T) {
+	server := testOpenAIModelServer(t, []string{"Bonsai-2-27B"}, `{"selected":"bonsai"}`)
+	defer server.Close()
+	t.Setenv("NEURA_BONSAI_URL", server.URL)
+	t.Setenv("NEURA_BITNET_URL", "")
+	t.Setenv("NEURA_GPTOSS_URL", "")
+	t.Setenv("NEURA_QWEN_URL", "")
+	s := &Server{cfg: defaultConfig(), rootDir: t.TempDir(), client: &http.Client{Timeout: 2 * time.Second}}
+	s.cfg.LlamaURL = "http://127.0.0.1:1"
+	s.cfg.LlamaModel = "primary"
+	s.modelFabric = OpenModelFabric(s.rootDir, s.cfg.LlamaURL, s.cfg.LlamaModel)
+	route, ok := s.selectLocalModelRoute(context.Background(), ModelTaskTestAuthor)
+	if !ok || route.Candidate.ID != "bonsai2-27b" {
+		t.Fatalf("route=%+v ok=%t", route, ok)
+	}
+	out, err := s.callOpenAICompatibleJSON(context.Background(), route, "{}", 64)
+	if err != nil || !strings.Contains(out, `"selected":"bonsai"`) {
+		t.Fatalf("out=%q err=%v", out, err)
+	}
+}
