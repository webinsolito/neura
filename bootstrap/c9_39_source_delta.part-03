+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, strings.TrimRight(c.Endpoint, "/")+"/v1/chat/completions", bytes.NewReader(payload))
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := s.client.Do(req)
+	if err != nil {
+		if b := s.modelFabric.breakerFor(c.ID); b != nil {
+			b.Failure()
 		}
+		return "", err
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
+	if err != nil {
+		return "", err
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		if b := s.modelFabric.breakerFor(c.ID); b != nil {
+			b.Failure()
+		}
+		return "", fmt.Errorf("IA locale %s HTTP %d: %s", c.ID, resp.StatusCode, compact(raw, 500))
+	}
+	var lr LlamaResponse
+	if err := json.Unmarshal(raw, &lr); err != nil {
+		return "", err
+	}
+	if len(lr.Choices) == 0 {
+		return "", errors.New("IA locale senza choices")
+	}
+	if b := s.modelFabric.breakerFor(c.ID); b != nil {
+		b.Success()
+	}
+	return cleanModelReply(lr.Choices[0].Message.Content), nil
+}
+
+// callLocalModel is the single inference entry point for local chat. C9.38 makes
+// it task-aware and runtime-agnostic while keeping every route local and zero-cost.
+func (s *Server) callLocalModel(ctx context.Context, user string, backend BackendChatResponse, rawBackend []byte, runtimeState string, history []HistoryEntry, memoryBlock, skillBlock string) (string, error) {
+	route, ok := s.selectLocalModelRoute(ctx, ModelTaskChat)
+	if !ok {
+		return "", errors.New("nessun runtime locale zero-cost OpenAI-compatible disponibile")
+	}
+	if route.Candidate.ID == "llama.cpp" {
 		out, err := s.callLlama(ctx, user, backend, rawBackend, runtimeState, history, memoryBlock, skillBlock)
-		if s.modelFabric.breaker != nil {
+		if b := s.modelFabric.breakerFor(route.Candidate.ID); b != nil {
 			if err != nil {
-				s.modelFabric.breaker.Failure()
+				b.Failure()
 			} else {
-				s.modelFabric.breaker.Success()
+				b.Success()
 			}
 		}
 		return out, err
-	default:
-		return "", errors.New("runtime selezionato senza adapter NEURA: " + candidate.ID)
 	}
+	// Preserve CAPO prompt semantics for alternate OpenAI-compatible local models
+	// by delegating through the same request format, with a compact authoritative
+	// context. The deterministic backend remains the source of truth.
+	var contextText strings.Builder
+	contextText.WriteString("MESSAGGIO UTENTE:\n")
+	contextText.WriteString(user)
+	contextText.WriteString("\n\nBACKEND NEURA (fonte di verita):\n")
+	if len(rawBackend) > 0 {
+		contextText.Write(rawBackend)
+	} else {
+		enc, _ := json.Marshal(backend)
+		contextText.Write(enc)
+	}
+	if runtimeState != "" {
+		contextText.WriteString("\n\nRUNTIME:\n" + runtimeState)
+	}
+	if memoryBlock != "" {
+		contextText.WriteString("\n\n" + memoryBlock)
+	}
+	if skillBlock != "" {
+		contextText.WriteString("\n\n" + skillBlock)
+	}
+	if len(history) > 0 {
+		contextText.WriteString("\n\nULTIMI SCAMBI LOCALI:\n")
+		for _, h := range history {
+			contextText.WriteString("Utente: " + h.User + "\nCAPO: " + h.Reply + "\n---\n")
+		}
+	}
+	system := "Sei CAPO, IA locale centrale di NEURA. Rispondi in italiano. Il backend NEURA e la fonte di verita: non inventare azioni eseguite o test superati. Nessun cloud/API a pagamento. Sii concreto."
+	reqBody := LlamaRequest{Model: route.Candidate.Model, Messages: []LlamaMessage{{Role: "system", Content: system}, {Role: "user", Content: contextText.String()}}, Temperature: s.cfg.Temperature, MaxTokens: s.cfg.MaxTokens, Stream: false}
+	payload, _ := json.Marshal(reqBody)
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, strings.TrimRight(route.Candidate.Endpoint, "/")+"/v1/chat/completions", bytes.NewReader(payload))
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := s.client.Do(req)
+	if err != nil {
+		s.modelFabric.breakerFor(route.Candidate.ID).Failure()
+		return "", err
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
+	if err != nil {
+		return "", err
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		s.modelFabric.breakerFor(route.Candidate.ID).Failure()
+		return "", fmt.Errorf("modello locale %s HTTP %d: %s", route.Candidate.ID, resp.StatusCode, compact(raw, 300))
+	}
+	var parsed LlamaResponse
+	if err := json.Unmarshal(raw, &parsed); err != nil || len(parsed.Choices) == 0 {
+		return "", errors.New("risposta modello locale non valida")
+	}
+	text := cleanModelReply(parsed.Choices[0].Message.Content)
+	if text == "" {
+		return "", errors.New("risposta modello locale vuota")
+	}
+	s.modelFabric.breakerFor(route.Candidate.ID).Success()
+	return text, nil
 }
 
 func (s *Server) handleModelFabric(w http.ResponseWriter, r *http.Request) {
@@ -129,6 +533,5 @@ func (s *Server) handleModelFabric(w http.ResponseWriter, r *http.Request) {
 		writeJSON(w, http.StatusServiceUnavailable, map[string]any{"ready": false, "error": "model_fabric_non_inizializzato"})
 		return
 	}
-	healthy := s.checkURL(r.Context(), strings.TrimRight(s.cfg.LlamaURL, "/")+"/health")
-	writeJSON(w, http.StatusOK, s.modelFabric.Status(healthy))
+	writeJSON(w, http.StatusOK, s.modelFabric.LiveStatus(r.Context(), s.client, s.cfg.LlamaURL, s.cfg.LlamaModel))
 }
