+func (m *ModelFabric) breakerFor(id string) *ModelCircuitBreaker {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.breakers == nil {
+		m.breakers = map[string]*ModelCircuitBreaker{}
+	}
+	if b := m.breakers[id]; b != nil {
+		return b
+	}
+	b := NewModelCircuitBreaker(2, 15*time.Second)
+	m.breakers[id] = b
+	return b
+}
+
+func probeOpenAICompatible(ctx context.Context, client *http.Client, c ModelRuntimeCandidate) bool {
+	if client == nil || !c.Local || c.Endpoint == "" || !c.Implemented || !c.ZeroCost {
+		return false
+	}
+	if _, ok := localOnlyEndpoint(c.Endpoint); !ok {
+		return false
+	}
+	probe := func(path string) (int, []byte, error) {
+		cctx, cancel := context.WithTimeout(ctx, 1800*time.Millisecond)
+		defer cancel()
+		req, err := http.NewRequestWithContext(cctx, http.MethodGet, strings.TrimRight(c.Endpoint, "/")+path, nil)
+		if err != nil {
+			return 0, nil, err
+		}
+		resp, err := client.Do(req)
+		if err != nil {
+			return 0, nil, err
+		}
+		defer resp.Body.Close()
+		b, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+		return resp.StatusCode, b, nil
+	}
+
+	// Identity is stronger than a generic /health response. Every new C9.38
+	// provider must expose an OpenAI-compatible model list matching the expected
+	// model. The legacy primary llama.cpp route keeps /health fallback so older
+	// local test/runtime installations remain compatible.
+	if status, body, err := probe("/v1/models"); err == nil && status >= 200 && status < 300 {
+		var models struct {
+			Data []struct {
+				ID string `json:"id"`
+			} `json:"data"`
+		}
+		if json.Unmarshal(body, &models) == nil && len(models.Data) > 0 {
+			if strings.TrimSpace(c.Model) == "" {
+				return true
+			}
+			for _, item := range models.Data {
+				if strings.EqualFold(strings.TrimSpace(item.ID), strings.TrimSpace(c.Model)) {
+					return true
+				}
+			}
+			return false
+		}
+	}
+	if c.ID == "llama.cpp" {
+		if status, _, err := probe("/health"); err == nil && status >= 200 && status < 300 {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *ModelFabric) LiveCandidates(ctx context.Context, client *http.Client, primaryEndpoint, primaryModel string) []ModelRuntimeCandidate {
+	primaryHealthy := false
+	if ep, ok := localOnlyEndpoint(primaryEndpoint); ok {
+		primaryHealthy = probeOpenAICompatible(ctx, client, ModelRuntimeCandidate{ID: "llama.cpp", Model: primaryModel, Endpoint: ep, Local: true, ZeroCost: true, Implemented: true})
+	}
+	out := m.staticCandidates(primaryEndpoint, primaryModel, primaryHealthy)
+	for i := range out {
+		if out[i].ID == "llama.cpp" {
+			out[i].Usable = primaryHealthy && out[i].Local
+			continue
+		}
+		if out[i].Implemented && out[i].Discovered && out[i].Endpoint != "" {
+			out[i].Usable = probeOpenAICompatible(ctx, client, out[i])
+		}
+	}
+	return out
+}
+
+func (m *ModelFabric) SelectRoute(ctx context.Context, client *http.Client, task ModelTask, primaryEndpoint, primaryModel string) (ModelRoute, bool) {
+	capability := taskCapability(task)
+	candidates := m.LiveCandidates(ctx, client, primaryEndpoint, primaryModel)
+	routes := make([]ModelRoute, 0, len(candidates))
+	for _, c := range candidates {
+		if !c.Usable || !c.Implemented || !c.Local || !c.ZeroCost || !candidateHasCapability(c, capability) {
+			continue
+		}
+		b := m.breakerFor(c.ID)
+		if b != nil && !b.Allow() {
+			continue
+		}
+		routes = append(routes, ModelRoute{Candidate: c, Task: task, Score: modelTaskPriority(c, task)})
+	}
+	if len(routes) == 0 {
+		return ModelRoute{}, false
+	}
+	sort.SliceStable(routes, func(i, j int) bool {
+		if routes[i].Score != routes[j].Score {
+			return routes[i].Score > routes[j].Score
+		}
+		return routes[i].Candidate.ID < routes[j].Candidate.ID
+	})
+	// Release breaker permits granted to non-selected routes. Otherwise a half-open
+	// route could be left permanently probe-in-flight merely because it lost rank.
+	for i := 1; i < len(routes); i++ {
+		if b := m.breakerFor(routes[i].Candidate.ID); b != nil {
+			b.Success()
+		}
+	}
+	return routes[0], true
+}
+
 func (m *ModelFabric) Status(localEndpointHealthy bool) map[string]any {
 	selected, ok := m.Select(localEndpointHealthy)
 	return map[string]any{
 		"ready":       ok,
 		"selected":    selected,
 		"candidates":  m.Candidates(localEndpointHealthy),
-		"policy":      "local_zero_cost_implemented_adapter_only_then_benchmark_before_switch",
+		"policy":      "local_zero_cost_loopback_only_task_aware_live_probe_then_deterministic_priority",
 		"host_goos":   runtime.GOOS,
 		"host_goarch": runtime.GOARCH,
 	}
 }
 
