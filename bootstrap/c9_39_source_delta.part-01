ar modelProbes, completions int
+	ai := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/v1/models":
+			modelProbes++
+			_ = json.NewEncoder(w).Encode(map[string]any{"data": []any{map[string]any{"id": "Bonsai-2-27B"}}})
+		case "/v1/chat/completions":
+			completions++
+			_ = json.NewEncoder(w).Encode(map[string]any{"choices": []any{map[string]any{"message": map[string]any{"role": "assistant", "content": `{"provider":"bonsai-secured"}`}}}})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer ai.Close()
+
+	root := t.TempDir()
+	writeIntegratedWardenPolicy(t, root, []string{"127.0.0.1"})
+	srv := newIntegratedTestServer(t, root, ai.URL)
+	srv.replay = nil
+	mgr := &EvolutionManager{srv: srv, cfg: defaultEvolutionConfig(), stopCh: make(chan struct{})}
+	out, err := mgr.callLocalJSON(context.Background(), "architect", "{}", 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out, `"provider":"bonsai-secured"`) {
+		t.Fatalf("unexpected output: %q", out)
+	}
+	if modelProbes < 1 || completions != 1 {
+		t.Fatalf("probes=%d completions=%d", modelProbes, completions)
+	}
+}
+
+func TestC939StrictReplayStaysOfflineWithWarden(t *testing.T) {
+	if os.Getenv("NEURA_WARDEN_BIN") == "" {
+		t.Skip("NEURA_WARDEN_BIN not set for integrated Warden test")
+	}
+	var modelProbes, completions int
+	ai := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/v1/models":
+			modelProbes++
+			_ = json.NewEncoder(w).Encode(map[string]any{"data": []any{map[string]any{"id": "Bonsai-2-27B"}}})
+		case "/v1/chat/completions":
+			completions++
+			_ = json.NewEncoder(w).Encode(map[string]any{"choices": []any{map[string]any{"message": map[string]any{"role": "assistant", "content": `{"replay":"seed"}`}}}})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+
+	root := t.TempDir()
+	writeIntegratedWardenPolicy(t, root, []string{"127.0.0.1"})
+	srv := newIntegratedTestServer(t, root, ai.URL)
+	srv.replay.setMode(ReplayRecord)
+	mgr := &EvolutionManager{srv: srv, cfg: defaultEvolutionConfig(), stopCh: make(chan struct{})}
+	first, err := mgr.callLocalJSON(context.Background(), "architect", "same-prompt", 64)
+	if err != nil || !strings.Contains(first, `"replay":"seed"`) {
+		t.Fatalf("record call out=%q err=%v", first, err)
+	}
+	beforeProbes, beforeCompletions := modelProbes, completions
+	ai.Close()
+	srv.replay.setMode(ReplayStrict)
+	second, err := mgr.callLocalJSON(context.Background(), "architect", "same-prompt", 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second != first {
+		t.Fatalf("replay mismatch first=%q second=%q", first, second)
+	}
+	if modelProbes != beforeProbes || completions != beforeCompletions {
+		t.Fatalf("strict replay touched model endpoint: probes %d->%d completions %d->%d", beforeProbes, modelProbes, beforeCompletions, completions)
+	}
+}
