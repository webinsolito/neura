+
+func taskForEvolutionRole(role string) ModelTask {
+	switch strings.ToLower(strings.TrimSpace(role)) {
+	case "test_author":
+		return ModelTaskTestAuthor
+	case "architect", "planner", "reviewer", "diagnostician":
+		return ModelTaskPlanning
+	case "editor", "patcher", "repairer":
+		return ModelTaskCoding
+	default:
+		return ModelTaskCoding
+	}
+}
+
+func (s *Server) selectLocalModelRoute(ctx context.Context, task ModelTask) (ModelRoute, bool) {
+	if s == nil || s.modelFabric == nil {
+		return ModelRoute{}, false
+	}
+	return s.modelFabric.SelectRoute(ctx, s.client, task, s.cfg.LlamaURL, s.cfg.LlamaModel)
+}
