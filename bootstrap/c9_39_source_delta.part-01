+func localOnlyEndpoint(raw string) (string, bool) {
+	raw = strings.TrimSpace(strings.TrimRight(raw, "/"))
+	if raw == "" {
+		return "", false
+	}
+	u, err := url.Parse(raw)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") {
+		return "", false
+	}
+	host := strings.ToLower(u.Hostname())
+	if host != "127.0.0.1" && host != "localhost" && host != "::1" {
+		return "", false
+	}
+	if u.User != nil {
+		return "", false
+	}
+	return raw, true
+}
+
+func envModelEndpoint(name string) string {
+	if v, ok := localOnlyEndpoint(os.Getenv(name)); ok {
+		return v
+	}
+	return ""
+}
+
+func envModelName(name, fallback string) string {
+	if v := strings.TrimSpace(os.Getenv(name)); v != "" {
+		return v
+	}
+	return fallback
+}
+
+func candidateHasCapability(c ModelRuntimeCandidate, cap string) bool {
+	for _, v := range c.Capabilities {
+		if strings.EqualFold(v, cap) {
+			return true
+		}
+	}
+	return false
+}
+
+func taskCapability(task ModelTask) string {
+	switch task {
+	case ModelTaskPlanning:
+		return "planning"
+	case ModelTaskCoding:
+		return "coding"
+	case ModelTaskTestAuthor:
+		return "test_author"
+	case ModelTaskRouting:
+		return "routing"
+	default:
+		return "chat"
+	}
+}
+
+func modelTaskPriority(c ModelRuntimeCandidate, task ModelTask) int {
+	base := c.Priority
+	switch c.ID {
+	case "bonsai2-27b":
+		switch task {
+		case ModelTaskCoding, ModelTaskTestAuthor, ModelTaskPlanning:
+			base += 35
+		case ModelTaskChat:
+			base += 20
+		}
+	case "qwen3.6-35b-a3b":
+		switch task {
+		case ModelTaskCoding, ModelTaskTestAuthor, ModelTaskPlanning:
+			base += 30
+		case ModelTaskChat:
+			base += 12
+		}
+	case "gpt-oss-20b":
+		switch task {
+		case ModelTaskCoding, ModelTaskTestAuthor, ModelTaskPlanning:
+			base += 25
+		case ModelTaskChat:
+			base += 15
+		}
+	case "bitnet":
+		if task == ModelTaskRouting {
+			base += 60
+		}
+	case "llama.cpp":
+		base += 5
+	}
+	return base
+}
